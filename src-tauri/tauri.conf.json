{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FieldGrow",
  "version": "0.2.1",
  "identifier": "com.smilexio.fieldgrow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FieldGrow · 地推拓客利器",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "地推拓客利器 — 地图商户检索与导出",
    "longDescription": "FieldGrow 是一款面向地推拓客场景的跨平台桌面工具:集成高德地图 POI 检索(关键词 / 区域框选 / 周边),沉淀商户信息到客户池,支持 Excel/CSV 一键导出。地图 Key 由用户在界面自助配置。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
